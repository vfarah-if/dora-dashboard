{
  "name": "@dora-dashboard/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React front end for the delivery metrics dashboard.",
  "scripts": {
    "dev": "vite --port 5181 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5181 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dora-dashboard/core": "*",
    "@tanstack/react-query": "^5.104.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^5.0.1",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.1"
  }
}

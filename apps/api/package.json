{
  "name": "@dora-dashboard/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "crawl": "tsx --env-file-if-exists=../../.env src/cli.ts"
  },
  "dependencies": {
    "@babel/parser": "^8.0.6",
    "@babel/types": "^8.0.6",
    "@dora-dashboard/core": "*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.5",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}

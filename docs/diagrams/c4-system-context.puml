@startuml c4-system-context
' C4 level 1, written for a non-technical reader: who uses the DORA Dashboard and where its figures come from.
' The tools it runs, the protocols and the sign-in modes belong in c4-container.puml, not here.
' Uses the C4-PlantUML library bundled with PlantUML, so it renders offline.
!include <C4/C4_Context>

LAYOUT_TOP_DOWN()
HIDE_STEREOTYPE()

title Who uses the DORA Dashboard and where its figures come from

Person(reader, "Team member or lead", "Opens the dashboard in a web browser to see how quickly and reliably the team delivers its work.")
Person(operator, "Operator", "Sets the dashboard up, chooses which projects it follows and refreshes the figures.")

System(dashboard, "DORA Dashboard", "Turns the history of the team's code changes and releases into charts, including the four DORA measures of how often, how quickly and how safely the team releases. It runs on the team's own equipment and only reads from the services below.")

System_Ext(github, "GitHub", "Where the team keeps its code, reviews each change and releases it.")
System_Ext(jira, "Jira (optional)", "Where the team plans and tracks its work.")

Rel(reader, dashboard, "Looks at charts, comparisons and changes waiting for review")
Rel(operator, dashboard, "Sets up and refreshes")

Rel(dashboard, github, "Reads the history of changes and releases")
Rel(dashboard, jira, "Reads planned work, when connected")

SHOW_LEGEND()
@enduml

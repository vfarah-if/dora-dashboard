# How the API obtains a GitHub token.
#   gh-cli : read `gh auth token` from the local GitHub CLI login (no sign-in screen)
#   oauth  : "Sign in with GitHub" through a registered OAuth App
AUTH_MODE=gh-cli

# OAuth App credentials, required only when AUTH_MODE=oauth.
# Register at https://github.com/organizations/<org>/settings/applications
# with the callback URL http://localhost:5181/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Client ID of an OAuth App with device flow enabled. In gh-cli mode it lets someone sign in from the
# browser when the GitHub CLI is not logged in. No secret is needed; leave blank to switch it off.
GITHUB_DEVICE_CLIENT_ID=

# Signs the session cookie. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Where the API listens, and where the SQLite cache is written (blank means <repo>/data/dora.sqlite).
PORT=8787
DATABASE_PATH=
WEB_ORIGIN=http://localhost:5181

# Clone and analyse code complexity during a crawl (needs git, and lizard for languages other than JavaScript and TypeScript). Set to "off" to disable.
CODE_ANALYSIS=on

# Jira (optional). Register an OAuth 2.0 (3LO) app at https://developer.atlassian.com/console/myapps/
# with the callback URL below, then set ATLASSIAN_CLIENT_ID and ATLASSIAN_CLIENT_SECRET together to switch
# Jira on. Leave both unset to leave it off; setting only one stops the API at start-up.
# ATLASSIAN_CLIENT_ID=
# ATLASSIAN_CLIENT_SECRET=
# Optional. Defaults to WEB_ORIGIN followed by /api/auth/jira/callback; set it only if that is not the address Atlassian has.
# ATLASSIAN_REDIRECT_URI=http://localhost:5181/api/auth/jira/callback
